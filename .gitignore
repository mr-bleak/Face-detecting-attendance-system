# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js build output
/.next/
/out/
/build

# Misc & OS
.DS_Store
Thumbs.db
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (Ensure .env.example is tracked for GitHub / Vercel onboarding)
.env*.local
.env
!.env.example

# Vercel deployment artifacts
.vercel

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# IDE workspace configurations
.vscode/
